{
  "name": "wenshu-desktop",
  "version": "0.1.0-alpha.1",
  "private": true,
  "license": "MIT",
  "description": "A local-first multi-document desktop workspace.",
  "productName": "文枢",
  "wenshu": {
    "appId": "io.github.ravenhu001.wenshu",
    "executableName": "WenShu"
  },
  "packageManager": "npm@10.9.2",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "package:dir": "npm run build && node scripts/run-electron-builder.mjs --config electron-builder.yml --win --x64 --dir --publish never && npm run package:verify -- --mode=dir",
    "package:win": "npm run build && node scripts/run-electron-builder.mjs --config electron-builder.yml --win --x64 --publish never && npm run package:verify -- --mode=win",
    "package:verify": "node scripts/verify-package.mjs",
    "release:verify:unsigned": "pwsh.exe -NoLogo -NoProfile -File scripts/verify-windows-release.ps1 -SignatureLevel Unsigned",
    "release:manifest:unsigned": "pwsh.exe -NoLogo -NoProfile -File scripts/verify-windows-release.ps1 -SignatureLevel Unsigned -GenerateManifest",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.config.json && tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude tests/e2e/**",
    "test:e2e": "vitest run tests/e2e/electron-smoke.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run notices:check && npm test"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-color": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "43.4.1",
    "electron-builder": "27.0.0-alpha.8",
    "electron-vite": "^4.0.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
